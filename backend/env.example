PORT=5001
NODE_ENV=development
DATABASE_URL=postgres://user:password@localhost:5433/mydb
# Prod: owner role used only to run migrations on container boot (the app
# role in DATABASE_URL has no CREATE). Empty = migrate with DATABASE_URL.
MIGRATION_DATABASE_URL=
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=info

# Ensayo aislado: ambos false. En producción, activarlos solo después del corte.
BACKGROUND_JOBS_ENABLED=true
EXTERNAL_EFFECTS_ENABLED=true

# JWT
JWT_SECRET=change-me-in-prod
JWT_EXPIRES_IN=15m

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-2024-08-06

# Cron
CRON_TZ=America/Argentina/Buenos_Aires
PROGRESSION_CRON_SCHEDULE=0 23 * * 0

# Compliance threshold (decimal, e.g. 0.6 = 60%)
COMPLIANCE_THRESHOLD=0.6

# Email transaccional por SMTP (Amazon SES). Sin SMTP_* fuera de producción
# los mails solo se loguean; en producción, cada envío falla hasta configurarlo.
# El host define la región de SES; usar 587 (Hetzner bloquea 465 y 25).
# Completar los tres (host, user, pass) o ninguno: a medias, cada envío falla.
# Prod: SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_HOST=
SMTP_PORT=587
# Credenciales SMTP de SES (no son access keys de IAM; son por región)
SMTP_USER=
SMTP_PASS=
# Remitente con dominio verificado en SES (DKIM) en la misma región que SMTP_HOST
MAIL_FROM=TR Fit <no-reply@tatoroblesfit.com>
# URL pública del logo para el header de los emails (opcional; si vacío usa texto)
EMAIL_LOGO_URL=
# Dirección real de respuesta/soporte (opcional; setea Reply-To)
SUPPORT_EMAIL=
APP_URL=http://localhost:5001
APP_DEEP_LINK_SCHEME=trfit

# Firebase Admin SDK (push notifications)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# MercadoPago (subscriptions)
MP_ACCESS_TOKEN=APP_USR-...
MP_WEBHOOK_SECRET=your-webhook-secret
MP_PLAN_ID_BASICO=                    # Run npm run mp:setup-plans to generate
MP_PLAN_ID_FULL=
MP_PLAN_ID_PREMIUM=
MP_BACK_URL=trfit://upgrade/success
MP_NOTIFICATION_URL=https://api.trfit.io/webhooks/mp

# Single owner admin (athletes route to this user on onboarding). Required.
# Create via: npx tsx src/scripts/create-admin.ts <email> <password>
OWNER_COACH_EMAIL=owner@example.com

# APNs (iOS Live Activity end pushes). APNS_KEY_P8 = contents of AuthKey_<id>.p8
# with literal \n newlines. Host: api.push.apple.com (prod) / api.sandbox.push.apple.com (dev).
APNS_KEY_P8=
APNS_KEY_ID=QTNUMPHW53
APNS_TEAM_ID=W6DLX49R4D
APNS_BUNDLE_ID=com.trfit.app
APNS_HOST=api.push.apple.com
